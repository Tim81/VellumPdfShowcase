<Project>

  <!--
    Both projects enable the trim analyzer, which makes the SDK reference
    Microsoft.NET.ILLink.Tasks at the version bundled with the SDK in use. SDK
    10.0.401 bundles 10.0.12, and no 10.0.12 package is published on nuget.org;
    the newest available is 10.0.11. Restore therefore failed with NU1103 on a
    tree that had built four days earlier, without any change to this repository.

    The version arrives as metadata on a KnownILLinkPack item that the SDK
    defines in Microsoft.NETCoreSdk.BundledVersions.props, so it cannot be set
    from Directory.Build.props, which is imported earlier. This file is imported
    after the SDK, which is why the override lives here.

    NOTE: the same release mismatch is pinned for the WebAssembly runtime pack in
    src/VellumPdfShowcase.Web/VellumPdfShowcase.Web.csproj. Raise the two
    together with the versions in Directory.Packages.props, and only to a version
    published on nuget.org.
  -->
  <ItemGroup>
    <KnownILLinkPack Update="Microsoft.NET.ILLink.Tasks">
      <ILLinkPackVersion Condition="'%(TargetFramework)' == 'net10.0'">10.0.11</ILLinkPackVersion>
    </KnownILLinkPack>
  </ItemGroup>

</Project>
