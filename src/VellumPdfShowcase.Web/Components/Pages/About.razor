<section>
    <h2>Conformance checking</h2>

    <p>
        The conformance page validates documents with VellumPdf.Conformance,
        running here in this browser. veraPDF is not executing on this site, and no
        result shown here comes from it.
    </p>
</section>

@code {
    // Read from the assemblies actually loaded rather than written by hand, so
    // this page cannot state a version the site is not running. The informational
    // version carries the package version; the assembly version does not.
    private static string LayoutVersion { get; } = VersionOf(typeof(VellumPdf.Document.PdfConformance));

    private static string ConformanceVersion { get; } = VersionOf(typeof(VellumPdf.Conformance.PdfPreflight));

    private static string VersionOf(Type type)
    {
        var assembly = type.Assembly;
        var informational = assembly
            .GetCustomAttributes(typeof(System.Reflection.AssemblyInformationalVersionAttribute), inherit: false)
            .OfType<System.Reflection.AssemblyInformationalVersionAttribute>()
            .FirstOrDefault();

        var value = informational?.InformationalVersion ?? assembly.GetName().Version?.ToString() ?? "unknown";

        // An informational version may carry build metadata after a '+'. The
        // version a reader would look up on NuGet is the part before it.
        var plus = value.IndexOf('+', StringComparison.Ordinal);
        return plus < 0 ? value : value[..plus];
    }
}
