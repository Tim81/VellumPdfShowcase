@implements IAsyncDisposable
@inject PdfInterop Interop

@*
    Renders generated bytes in the browser's own PDF viewer, through a blob URL.

    NOTE there is deliberately no bundled JavaScript viewer. One would add about a
    megabyte to a payload being held small, and for a showcase of a PDF library,
    rendering in the viewers of Chrome, Firefox and Safari is stronger evidence
    than rendering in a viewer this site controls.

    NOTE the iframe is keyed on the URL. Changing only the fragment does not always
    re-navigate an already loaded frame, so the element is recreated instead.
*@

<div class="pdf-preview">
    @if (Bytes is null)
    {
        <p class="pdf-preview-empty">@EmptyMessage</p>
    }
    else if (_supportsInline)
    {
        <iframe @key="_blobUrl" src="@_blobUrl" title="@Title" class="pdf-preview-frame"></iframe>
    }
    else
    {
        @* Mobile Safari and Android Chrome do not render a PDF inline in a frame
           reliably, so the preview becomes a download rather than an empty box. *@
        <div class="pdf-preview-fallback">
            <p>This browser does not render a PDF inside the page.</p>
            <button type="button" class="button" disabled="@_downloading" @onclick="DownloadAsync">
                @(_downloading ? "Preparing…" : $"Download {FileName}")
            </button>
        </div>
    }

    @if (_error is not null)
    {
        <p class="error" role="alert">@_error</p>
    }
</div>

@code {
    private string? _blobUrl;
    private byte[]? _shownBytes;
    private bool _supportsInline = true;
    private bool _downloading;
    private string? _error;
    private bool _disposed;

    /// <summary>The bytes to show. Null renders the empty state.</summary>
    [Parameter]
    public byte[]? Bytes { get; set; }

    /// <summary>The accessible name of the frame.</summary>
    [Parameter]
    public string Title { get; set; } = "Generated PDF document";

    /// <summary>The name offered when the visitor downloads.</summary>
    [Parameter]
    public string FileName { get; set; } = "document.pdf";

    /// <summary>What to say when there is nothing to show yet.</summary>
    [Parameter]
    public string EmptyMessage { get; set; } = "Nothing generated yet.";

    protected override async Task OnParametersSetAsync()
    {
        // Compared by reference on purpose. The pages hand over a fresh array on
        // every generation, so reference identity answers "is this a new document"
        // without comparing several hundred kilobytes on every render.
        if (ReferenceEquals(Bytes, _shownBytes))
        {
            return;
        }

        _shownBytes = Bytes;
        _error = null;

        var previousUrl = _blobUrl;
        _blobUrl = null;

        if (Bytes is not null)
        {
            try
            {
                _supportsInline = await Interop.DetectInlineSupportAsync();

                if (_supportsInline)
                {
                    _blobUrl = await Interop.CreateBlobUrlAsync(Bytes);
                }
            }
            catch (Exception ex)
            {
                _error = $"The preview could not be prepared: {ex.Message}";
            }
        }

        // Revoked after the new URL is in hand, so no URL is ever dropped while
        // nothing holds a reference to it.
        await Interop.RevokeBlobUrlAsync(previousUrl);
    }

    private async Task DownloadAsync()
    {
        if (Bytes is null || _downloading)
        {
            return;
        }

        _downloading = true;
        _error = null;

        try
        {
            await Interop.DownloadAsync(Bytes, FileName);
        }
        catch (Exception ex)
        {
            if (!_disposed)
            {
                _error = $"The download failed: {ex.Message}";
            }
        }
        finally
        {
            if (!_disposed)
            {
                _downloading = false;
            }
        }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;

        var url = _blobUrl;
        _blobUrl = null;
        await Interop.RevokeBlobUrlAsync(url);
    }
}
