<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">VellumPdf Showcase</a>
        <button title="Navigation menu" class="navbar-toggler" aria-expanded="@(!collapseNavMenu)" aria-controls="main-nav-menu" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>

<div id="main-nav-menu" class="@NavMenuCssClass nav-scrollable" @onclick="ToggleNavMenu">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Home
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="playground">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Playground
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="compliance">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Conformance
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="about">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> About
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="smoke">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Smoke test
            </NavLink>
        </div>
    </nav>
</div>

@code {
    private bool collapseNavMenu = true;

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }
}
