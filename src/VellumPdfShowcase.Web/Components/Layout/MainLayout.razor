@inherits LayoutComponentBase
<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <a href="https://github.com/Tim81/VellumPdfShowcase" target="_blank" rel="noopener noreferrer">About</a>
        </div>

        <article class="content px-4">
            <ErrorBoundary>
                <ChildContent>
                    @Body
                </ChildContent>
                <ErrorContent>
                    <p role="alert">
                        This page failed to render. Reload to try again.
                    </p>
                </ErrorContent>
            </ErrorBoundary>
        </article>
    </main>
</div>
