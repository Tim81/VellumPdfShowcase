<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <TrimMode>full</TrimMode>
    <CompressionEnabled>false</CompressionEnabled>
    <!--
      Microsoft.NET.Sdk.BlazorWebAssembly defaults this to true when the project
      leaves it unset, which replaces BCL exception messages with resource keys
      (for example "Arg_IndexOutOfRangeException" instead of a sentence). This
      site displays exception text when generation fails, so the setting is
      overridden explicitly. Verify in the emitted runtimeconfig.json rather
      than by reading this file: the key is System.Resources.UseSystemResourceKeys.
    -->
    <UseSystemResourceKeys>false</UseSystemResourceKeys>
    <BlazorWebAssemblyLoadAllGlobalizationData>false</BlazorWebAssemblyLoadAllGlobalizationData>
    <RunAOTCompilation>false</RunAOTCompilation>
    <DebuggerSupport>false</DebuggerSupport>
    <EventSourceSupport>false</EventSourceSupport>
    <MetadataUpdaterSupport>false</MetadataUpdaterSupport>
    <HttpActivityPropagationSupport>false</HttpActivityPropagationSupport>
    <!--
      IL2111 fires on the framework Router component itself (OpenComponent<Router> in the
      Razor-generated App.razor), independent of which parameters the markup sets. Verified
      that a real `dotnet publish` with the trim analyzer disabled links cleanly and that the
      linker (not just the build-time analyzer) raises nothing equivalent for this component.
      Scoped to this one diagnostic so the analyzer still watches VellumPdf usage.
    -->
    <NoWarn>$(NoWarn);IL2111</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" PrivateAssets="all" />
    <PackageReference Include="VellumPdf.Layout" />
    <PackageReference Include="VellumPdf.Conformance" />
  </ItemGroup>

  <ItemGroup>
    <TrimmerRootDescriptor Include="ILLink.Descriptors.xml" />
  </ItemGroup>

</Project>
